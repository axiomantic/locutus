{
  "version": "1.0.0",
  "description": "Message exchange and routing for software agents over Redis without a background daemon",
  "homepage": "https://github.com/axiomantic/locutus",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/axiomantic/locutus/releases/download/v1.0.0/locutus-windows-amd64.zip",
      "bin": "locutus.exe"
    }
  },
  "post_install": [
    "if (Get-Command npx -ErrorAction SilentlyContinue) {",
    "    try { npx -y skills add \"$dir\\skills\\locutus\" -g -a '*' -y } catch { }",
    "} elseif (Get-Command skilz -ErrorAction SilentlyContinue) {",
    "    try { skilz install -f \"$dir\\skills\\locutus\" } catch { }",
    "}"
  ],
  "post_uninstall": [
    "if (Get-Command npx -ErrorAction SilentlyContinue) {",
    "    try { npx -y skills remove locutus -g -y } catch { }",
    "} elseif (Get-Command skilz -ErrorAction SilentlyContinue) {",
    "    try { skilz remove locutus } catch { }",
    "}"
  ],
  "notes": [
    "To equip your AI coding assistants (Claude Code, Antigravity, OpenCode, Cursor):",
    "  npx skills add axiomantic/locutus -g",
    "  # Or using skilz:",
    "  skilz install https://github.com/axiomantic/locutus",
    "  # Or offline from local Scoop files:",
    "  npx skills add \"$dir\\skills\\locutus\" -g"
  ],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/axiomantic/locutus/releases/download/v$version/locutus-windows-amd64.zip"
      }
    }
  }
}
